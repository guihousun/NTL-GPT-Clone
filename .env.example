# Required
DeepSeek_API_KEY=
DeepSeek_Coding_URL=

# Required internal DashScope channels for VLM, knowledge-base search, and embeddings
DASHSCOPE_API_KEY=
DASHSCOPE_Qwen_plus_KEY=
DASHSCOPE_Qwen_plus_URL=

# Optional runtime settings
NTL_TOOL_PROFILE=default
NTL_USER_DATA_DIR=
NTL_SHARED_DATA_DIR=
NTL_THREAD_ID=
NTL_CONTEXTILY_TMP=
NTL_FORCE_NATIVE_CHAT_INPUT=1
NTL_USE_CUSTOM_MULTIMODAL_CHAT_INPUT=0
NTL_VLM_MODEL=qwen3.5-plus

# PostgreSQL persistence for production deployments
# If NTL_HISTORY_DB_URL is empty, history storage falls back to NTL_LANGGRAPH_POSTGRES_URL.
NTL_HISTORY_DB_URL=
NTL_LANGGRAPH_POSTGRES_URL=

# Runtime safety limits. Use 0 to disable a limit.
NTL_MAX_ACTIVE_RUNS=10
NTL_MAX_ACTIVE_RUNS_PER_USER=2
NTL_THREAD_WORKSPACE_QUOTA_MB=500
NTL_USER_WORKSPACE_QUOTA_MB=1024

# Optional external services
GEE_DEFAULT_PROJECT_ID=
EARTHDATA_TOKEN=

# Optional local stdio MCP runtime
NTL_MCP_ENV_FILE=
NTL_MCP_WORKDIR=
NTL_MCP_STATE_DIR=.ntl-mcp

# RAG / knowledge-base embeddings. DashScope is the default provider.
NTL_EMBEDDING_PROVIDER=dashscope
NTL_EMBEDDING_MODEL=text-embedding-v4
NTL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NTL_EMBEDDING_DIMENSIONS=1024
# Optional override; if empty, DASHSCOPE_Qwen_plus_KEY is used for DashScope embeddings.
NTL_EMBEDDING_API_KEY=
# Optional only if you explicitly set NTL_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Optional only if you use Google BigQuery features
# GOOGLE_APPLICATION_CREDENTIALS=
